{
  "AllowedHosts": "accounts.example.com",
  "App": {
    "FrontendOrigin": "https://accounts.example.com",
    "PublicOrigin": "https://accounts.example.com",
    "ForceDemo": false
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "OAuth": {
    "Google": {
      "ClientId": "REPLACE_WITH_GOOGLE_WEB_CLIENT_ID",
      "ClientSecret": "REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET"
    },
    "Github": {
      "ClientId": "REPLACE_WITH_GITHUB_OAUTH_APP_CLIENT_ID",
      "ClientSecret": "REPLACE_WITH_GITHUB_OAUTH_APP_CLIENT_SECRET"
    },
    "Discord": {
      "ClientId": "REPLACE_WITH_DISCORD_APPLICATION_CLIENT_ID",
      "ClientSecret": "REPLACE_WITH_DISCORD_APPLICATION_CLIENT_SECRET"
    }
  },
  "Persistence": {
    "WorkspaceDirectory": "App_Data/workspaces"
  },
  "DataProtection": {
    "KeysPath": "App_Data/data-protection-keys"
  }
}
